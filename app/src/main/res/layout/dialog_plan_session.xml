<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asignatura:"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="sans-serif-medium" />

    <Spinner
        android:id="@+id/spnMateriasPlan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_micro"
        android:layout_marginBottom="@dimen/spacing_small" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Técnica de Estudio:"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="sans-serif-medium" />

    <Spinner
        android:id="@+id/spnTecnicaPlan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_micro"
        android:layout_marginBottom="@dimen/spacing_small" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha y Hora (Toca para seleccionar):"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/txtFechaHoraSeleccionada"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_micro"
        android:layout_marginBottom="@dimen/spacing_small"
        android:background="@drawable/shape_swatch_rounded"
        android:backgroundTint="@color/color_surface_variant"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_small"
        android:text="Toca aquí para definir fecha y hora..."
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duración estimada (minutos):"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/edtDuracionPlan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_micro"
        android:background="@drawable/shape_swatch_rounded"
        android:backgroundTint="@color/color_surface_variant"
        android:inputType="number"
        android:paddingHorizontal="@dimen/spacing_small"
        android:text="60"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_body" />

</LinearLayout>
