<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/crdAgendaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_outline_variant"
    app:strokeWidth="@dimen/stroke_width_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_small">

        <View
            android:id="@+id/viewSwatchAgenda"
            android:layout_width="@dimen/swatch_indicator_size"
            android:layout_height="@dimen/swatch_indicator_size"
            android:background="@drawable/shape_swatch_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:backgroundTint="@color/color_sub_mobile" />

        <TextView
            android:id="@+id/txtNombreMateriaAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_small"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/color_on_surface"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintEnd_toStartOf="@+id/txtChipEstadoAgenda"
            app:layout_constraintStart_toEndOf="@+id/viewSwatchAgenda"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Aplicaciones Móviles I" />

        <TextView
            android:id="@+id/txtDetalleHorarioAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintEnd_toStartOf="@+id/txtChipEstadoAgenda"
            app:layout_constraintStart_toEndOf="@+id/viewSwatchAgenda"
            app:layout_constraintTop_toBottomOf="@+id/txtNombreMateriaAgenda"
            tools:text="16:00 - 17:30 (90 min) • Pomodoro" />

        <TextView
            android:id="@+id/txtChipEstadoAgenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_swatch_rounded"
            android:backgroundTint="@color/color_surface_variant"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingVertical="@dimen/spacing_micro"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="@dimen/text_size_caption"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Pendiente" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
