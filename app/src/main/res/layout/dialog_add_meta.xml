<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/metas_dialog_titulo"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_title"
        android:layout_marginBottom="@dimen/spacing_medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Asignatura:"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:layout_marginBottom="@dimen/spacing_micro" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/corner_radius_card"
        app:cardElevation="0dp"
        app:strokeColor="@color/color_outline_variant"
        app:strokeWidth="@dimen/stroke_width_card">

        <Spinner
            android:id="@+id/spnMateriasMeta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="@dimen/spacing_small" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHorasMeta"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:hint="@string/metas_campo_horas">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtHorasMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="5.0" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rango permitido: 1.0 a 50.0 horas semanales (RN-MET-01)"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="11sp" />

</LinearLayout>
