<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Buscador Material Design 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/spacing_small"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="@dimen/stroke_width_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_small">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/color_on_surface_variant" />

                <EditText
                    android:id="@+id/edtBuscarMateria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@null"
                    android:hint="@string/materias_hint_buscar"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contador y Chip 5S -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small">

            <TextView
                android:id="@+id/txtConteoMaterias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="@dimen/text_size_caption"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="4 Materias Registradas" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_swatch_rounded"
                android:backgroundTint="@color/color_surface_variant"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="@dimen/spacing_micro"
                android:text="@string/materias_metodo_5s"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="@dimen/text_size_caption"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Estado Vacío (Empty State) -->
        <LinearLayout
            android:id="@+id/layoutEstadoVacioMaterias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/color_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:fontFamily="sans-serif-bold"
                android:text="@string/materias_empty_titulo"
                android:textColor="@color/color_on_surface"
                android:textSize="@dimen/text_size_subtitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:gravity="center"
                android:text="@string/materias_empty_subtitulo"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="@dimen/text_size_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarPrimeraMateria"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/materias_btn_registrar_primera"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

        <!-- Listado de Materias -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMaterias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:itemCount="4"
            tools:listitem="@layout/item_materia" />

    </LinearLayout>

    <!-- FAB Agregar Materia (HU-01) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_medium"
        android:contentDescription="@string/cd_agregar_materia"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/color_primary"
        app:tint="@color/color_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
