<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:id="@+id/txtTituloDialogoMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/materias_dialog_crear_titulo"
        android:textColor="@color/color_on_surface"
        android:textSize="@dimen/text_size_title"
        android:layout_marginBottom="@dimen/spacing_medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNombreMateria"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:hint="@string/materias_campo_nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNombreMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSiglaMateria"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:hint="@string/materias_campo_sigla">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtSiglaMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/materias_campo_color"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="@dimen/text_size_caption"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Selector de colores en paleta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_large">

        <View
            android:id="@+id/swatchColor1"
            android:layout_width="@dimen/swatch_picker_size"
            android:layout_height="@dimen/swatch_picker_size"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/shape_swatch_rounded"
            android:backgroundTint="@color/color_sub_mobile" />

        <View
            android:id="@+id/swatchColor2"
            android:layout_width="@dimen/swatch_picker_size"
            android:layout_height="@dimen/swatch_picker_size"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/shape_swatch_rounded"
            android:backgroundTint="@color/color_sub_os" />

        <View
            android:id="@+id/swatchColor3"
            android:layout_width="@dimen/swatch_picker_size"
            android:layout_height="@dimen/swatch_picker_size"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/shape_swatch_rounded"
            android:backgroundTint="@color/color_sub_networks" />

        <View
            android:id="@+id/swatchColor4"
            android:layout_width="@dimen/swatch_picker_size"
            android:layout_height="@dimen/swatch_picker_size"
            android:background="@drawable/shape_swatch_rounded"
            android:backgroundTint="@color/color_sub_calc" />
    </LinearLayout>

</LinearLayout>
