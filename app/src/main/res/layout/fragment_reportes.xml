<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Selector de Periodo (Semana / Mes) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/togglePeriodoReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:checkedButton="@+id/btnPeriodoSemana"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeriodoSemana"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reportes_tab_semana" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeriodoMes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reportes_tab_mes" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- KPIs: Horas Totales y Promedio Diario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_outline_variant"
                app:strokeWidth="@dimen/stroke_width_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reportes_kpi_horas"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/txtKpiHorasTotales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/text_size_title"
                        tools:text="14h 00m" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_outline_variant"
                app:strokeWidth="@dimen/stroke_width_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reportes_kpi_promedio"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/txtKpiPromedioDiario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/color_on_surface"
                        android:textSize="@dimen/text_size_title"
                        tools:text="2h 00m / día" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Distribución por Materia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="@dimen/stroke_width_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/reportes_distribucion_titulo"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/txtDetalleDistribucion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_caption"
                    tools:text="■ Aplicaciones Móviles (45%)\n■ Sistemas Operativos (27%)\n■ Redes (18%)\n■ Cálculo (10%)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dedicación Diaria (Barras de Días) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="@dimen/stroke_width_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/reportes_dedicacion_titulo"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/txtResumenDedicacionDiaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="@dimen/text_size_caption"
                    tools:text="Lun: 1h 30m | Mar: 2h 00m | Mié: 1h 45m | Jue: 2h 30m | Vie: 2h 00m | Sáb: 1h 00m | Dom: 0m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Histórico Reciente de Sesiones (HU-10) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="@dimen/stroke_width_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/reportes_historico_titulo"
                    android:textColor="@color/color_on_surface"
                    android:textSize="@dimen/text_size_subtitle"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistoricoSesiones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_historico_sesion" />

                <TextView
                    android:id="@+id/txtSinHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/spacing_small"
                    android:text="@string/reportes_sin_datos"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="@dimen/text_size_caption"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
