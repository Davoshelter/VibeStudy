<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".MainActivity">

    <!-- Top App Bar Material Design 3 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbPrincipal"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_surface"
        android:elevation="1dp"
        app:title="@string/app_name"
        app:titleTextColor="@color/color_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:navigationIcon="@drawable/ic_spa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenedor Principal de Fragmentos -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcvContenedorPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/navInferiorPrincipal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbPrincipal" />

    <!-- Barra de Navegación Inferior M3 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferiorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="4dp"
        app:itemIconTint="@color/color_on_surface_variant"
        app:itemTextColor="@color/color_on_surface_variant"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
